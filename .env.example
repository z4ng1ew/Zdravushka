# Стенд «Регистратура» (токен выдадут в личном кабинете). Пусто = демо-режим
STAND_URL=https://crm-med-mock.dbi-testing.ru/api/v1
STAND_TOKEN=

# Языковая модель (OpenAI-совместимый API): Ollama локально или удалённый сервер
LLM_URL=http://127.0.0.1:11434/v1
LLM_TOKEN=
LLM_MODEL=

# Распознавание речи
STT_URL=
STT_TOKEN=
STT_MODEL=openai/whisper-1

# Синтез речи: piper (локально) или openai (TTS_URL)
TTS_BACKEND=piper
PIPER_MODEL=data/voices/ru_RU-irina-medium.onnx
TTS_URL=                 # Silero на Mac: http://адрес-мака:8020/v1 (TTS_BACKEND=openai)
TTS_TOKEN=
TTS_MODEL=
TTS_VOICE=

# Телефония: мост AudioSocket для Asterisk
TELEPHONY_ENABLED=1
AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=9092
VAD_THRESHOLD=500
END_OF_SPEECH_MS=800
